{
  "name": "household-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/sync-public-data.mjs && next dev",
    "build": "next build",
    "build:pages": "node scripts/sync-public-data.mjs && GITHUB_PAGES=true NEXT_PUBLIC_BASE_PATH=/zizi-family-hub next build",
    "start": "next start",
    "lint": "eslint",
    "test:outing": "npx --yes tsx --test src/lib/outing-reminders.test.ts",
    "test:add-meal": "npx --yes tsx --test src/lib/add-youtube-recipe.test.ts",
    "sync-data": "node scripts/sync-public-data.mjs",
    "seed": "node scripts/seed-supabase.mjs",
    "fetch-live": "node scripts/fetch-live-content.mjs",
    "patch-live": "node scripts/patch-live-content.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
