# Supabase (required for production on Vercel) — Admin Save writes here (live truth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin password (server-side only — not exposed to browser)
ADMIN_PASSWORD=charlene2026

# Google Admin login (Supabase Auth → Google provider must be enabled)
# Also add redirect URLs in Supabase Auth → URL Configuration:
#   https://zizi-family-hub.vercel.app/admin/auth/callback
#   https://zizi-family-hub.vercel.app/auth/callback
# Users / frontend login requirement: Admin → Access

# Rare: force overwrite Supabase from repo content.json on next read
# FORCE_SEED_FROM_LOCAL=1

# Optional: smarter Ask / WhatsApp answers
# Prefer OpenRouter free models (no OpenAI bill):
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openrouter/free
# Optional public site URL (Ask / WhatsApp “send me the link”)
# NEXT_PUBLIC_APP_URL=https://zizi-family-hub.vercel.app

# OPENROUTER_SITE_URL=https://zizi-family-hub.vercel.app
# OPENROUTER_APP_NAME=Zizi Family Hub
#
# Or paid OpenAI:
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# WhatsApp Cloud API (Meta) — webhook: https://your-domain/api/whatsapp
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=zizi-family-verify
# WHATSAPP_TRIGGER_PREFIX=?
# WHATSAPP_REPLY_ALL=0

# Baileys bot inbox → Admin WA Inbox (must match bot INBOX_SECRET)
# INBOX_SECRET=change-me-long-random

# Optional: GitHub Pages static build (legacy)
# GITHUB_PAGES=true
# NEXT_PUBLIC_BASE_PATH=/zizi-family-hub
