# Supabase (required for production on Vercel) — Admin Save writes here (live truth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin password (server-side only — not exposed to browser)
ADMIN_PASSWORD=charlene2026

# Rare: force overwrite Supabase from repo content.json on next read
# FORCE_SEED_FROM_LOCAL=1

# Optional: smarter Ask / WhatsApp answers
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# WhatsApp Cloud API (Meta) — webhook: https://your-domain/api/whatsapp
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=zizi-family-verify
# WHATSAPP_TRIGGER_PREFIX=?
# WHATSAPP_REPLY_ALL=0

# Optional: GitHub Pages static build (legacy)
# GITHUB_PAGES=true
# NEXT_PUBLIC_BASE_PATH=/zizi-family-hub
