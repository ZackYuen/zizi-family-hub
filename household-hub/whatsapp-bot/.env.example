# Live Ask API (trailing slash avoids Vercel 308 redirect issues)
LIVE_ASK_URL=https://zizi-family-hub.vercel.app/api/ask/

# Same secret as Vercel INBOX_SECRET — logs asks + save tip/recipe into Admin → WA Inbox
INBOX_SECRET=change-me-long-random
# LIVE_INBOX_URL=https://zizi-family-hub.vercel.app/api/inbox/

# How people wake the bot
BOT_NAME=CharleneBot
TRIGGER_PREFIX=?

# Groups: bare "?" is ignored by default (avoids accidental replies).
# Wake with @CharleneBot / ask: / bot: instead. Set 1 to restore old ? wake in groups.
# GROUP_BARE_PREFIX=0

# Optional: only these group IDs (comma-separated). Empty = all groups the number is in.
# Strongly recommended — put only the family group here.
# Get IDs from logs after joining: [ask] 120363...@g.us
# GROUP_JIDS=120363xxxxx@g.us

# Reply in 1:1 chats too? 0=no 1=yes (in DMs, bare ? still works)
REPLY_DM=0

# Session folder (do not commit). Default: ~/.zizi-whatsapp-auth
# NEVER set AUTH_DIR=./auth_info — causes EACCES + MessageCounterError on the VM.
# AUTH_DIR=/home/ocuser/.zizi-whatsapp-auth
LOG_LEVEL=info
