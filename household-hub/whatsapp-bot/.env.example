# Live Ask API (trailing slash avoids Vercel 308 redirect issues)
LIVE_ASK_URL=https://zizi-family-hub.vercel.app/api/ask/

# Same secret as Vercel INBOX_SECRET — logs asks + save tip/recipe into Admin → WA Inbox
INBOX_SECRET=change-me-long-random
# LIVE_INBOX_URL=https://zizi-family-hub.vercel.app/api/inbox/

# How people wake the bot in the family group
BOT_NAME=CharleneBot
TRIGGER_PREFIX=?

# REQUIRED: only reply in these group(s). Empty = ignore all groups (safe default).
# Get the id from pm2 logs after someone posts in the family group:
#   [msg] skip 120363xxxxx@g.us (groups off …)
# Then set:
GROUP_JIDS=120363xxxxx@g.us
# Escape hatch (unsafe): listen in every group the number is in
# GROUP_ALLOW_ALL=1

# Reply in 1:1 chats too? 0=no 1=yes
REPLY_DM=0

# Local mute (1 = never reply). Prefer Admin → Settings → Pause WhatsApp bot.
# WHATSAPP_BOT_PAUSED=1
# Optional override for pause status API (default derived from LIVE_ASK_URL)
# LIVE_BOT_STATUS_URL=https://zizi-family-hub.vercel.app/api/bot-status/

# Session folder (do not commit). Default: ~/.zizi-whatsapp-auth
# NEVER set AUTH_DIR=./auth_info — causes EACCES + MessageCounterError on the VM.
# AUTH_DIR=/home/ocuser/.zizi-whatsapp-auth
LOG_LEVEL=info
