  "groundRules": [
    {
      "id": "rule-1",
      "title": {
        "en": "No Borrowing Money",
        "fil": "Huwag Humiram ng Pera"
      },
      "description": {
        "en": "Do not borrow money from anyone — employers, neighbours, or other helpers. If you need something, please ask the employer directly.",
        "fil": "Huwag humiram ng pera mula sa sinuman — employer, kapitbahay, o ibang katulong. Kung may kailangan ka, diretso mong tanungin ang employer."
      },
      "category": "general",
      "priority": 1
    },
    {
      "id": "rule-2",
      "title": {
        "en": "Zizi Comes First",
        "fil": "Si Zizi ang Unahin"
      },
      "description": {
        "en": "Zizi (our son) is the top priority. His meals, nap time, homework, and safety come before other household tasks. If Zizi needs attention, stop other work and help him first.",
        "fil": "Si Zizi (ang anak namin) ang unang prayoridad. Ang pagkain, tulog, takdang-aralin, at kaligtasan niya ay mas mahalaga kaysa ibang gawaing bahay. Kung kailangan ni Zizi ng tulong, itigil muna ang iba at unahin siya."
      },
      "category": "childcare",
      "priority": 2
    },
    {
      "id": "rule-3",
      "title": {
        "en": "Separate Raw & Cooked Meat Tools",
        "fil": "Hiwalay na Gamit para sa Hilaw at Lutong Karne"
      },
      "description": {
        "en": "Always use separate chopping boards and knives for raw (fresh) meat and cooked meat. Never mix them. Wash hands and tools after handling raw meat.",
        "fil": "Laging gumamit ng hiwalay na chopping board at kutsilyo para sa hilaw (sariwang) karne at lutong karne. Huwag pagsamahin. Maghugas ng kamay at gamit pagkatapos humawak ng hilaw na karne."
      },
      "category": "kitchen",
      "priority": 3
    },
    {
      "id": "rule-4",
      "title": {
        "en": "Label Chopping Boards",
        "fil": "Lagyan ng Label ang Chopping Board"
      },
      "description": {
        "en": "Red board & knife = raw meat only. Green board & knife = cooked food / vegetables. Blue board = fish only. Clean and dry after each use.",
        "fil": "Pula na board at kutsilyo = hilaw na karne lang. Berde na board at kutsilyo = lutong pagkain / gulay. Asul na board = isda lang. Linisin at patuyuin pagkatapos gamitin."
      },
      "category": "kitchen",
      "priority": 4
    },
    {
      "id": "rule-5",
      "title": {
        "en": "Daily Rest Time",
        "fil": "Araw-araw na Oras ng Pahinga"
      },
      "description": {
        "en": "You have a rest break every day as agreed. Please finish urgent tasks for Zizi before resting.",
        "fil": "May oras ka ng pahinga araw-araw ayon sa kasunduan. Tapusin muna ang mga urgent na gawain para kay Zizi bago magpahinga."
      },
      "category": "general",
      "priority": 5
    },
    {
      "id": "rule-6",
      "title": {
        "en": "Keep Phone for Emergencies During Work",
        "fil": "Telepono para sa Emergency Lang Habang Nagtatrabaho"
      },
      "description": {
        "en": "Personal phone use should be during rest time only. Keep phone nearby for emergencies and employer contact.",
        "fil": "Ang personal na telepono ay sa oras ng pahinga lang. Ilagay malapit ang telepono para sa emergency at contact ng employer."
      },
      "category": "general",
      "priority": 6
    },
    {
      "id": "rule-7",
      "title": {
        "en": "Report Problems Immediately",
        "fil": "I-report Agad ang Problema"
      },
      "description": {
        "en": "If something breaks, if Zizi is unwell, or if you are unsure about anything — tell the employer right away. Do not wait.",
        "fil": "Kung may masira, kung may sakit si Zizi, o kung may hindi ka sigurado — sabihin agad sa employer. Huwag maghintay."
      },
      "category": "safety",
      "priority": 7
    },
    {
      "id": "rule-8",
      "title": {
        "en": "Lock Doors & Windows",
        "fil": "I-lock ang Pinto at Bintana"
      },
      "description": {
        "en": "Always lock the main door when leaving or at night. Check windows before sleeping.",
        "fil": "Laging i-lock ang pangunahing pinto kapag aalis o sa gabi. Suriin ang mga bintana bago matulog."
      },
      "category": "safety",
      "priority": 8
    }
  ],
